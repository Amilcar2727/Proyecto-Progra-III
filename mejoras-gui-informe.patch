diff --git a/tests/test_backtracking.py b/tests/test_backtracking.py
index ff27718..5240a89 100644
--- a/tests/test_backtracking.py
+++ b/tests/test_backtracking.py
@@ -73,3 +73,29 @@ def test_backtracking_poda_por_costo():
     # En un recorrido largo en la red de Cusco, debe haber podas efectivas por cota
     assert res.total_ramas_podadas > 0
     assert res.ruta_optima is not None
+
+
+def test_sin_poda_enumera_todas_las_rutas_san_blas_wanchaq():
+    """Caso del enunciado: todas las rutas de San Blas (N02) a Wanchaq (N11)."""
+    from core.gestor_datos import cargar_grafo
+    g = cargar_grafo()
+    sin_poda = buscar_rutas_backtracking(g, "N02", "N11", usar_poda=False)
+    con_poda = buscar_rutas_backtracking(g, "N02", "N11", usar_poda=True)
+    assert len(sin_poda.rutas_encontradas) == 27
+    assert sin_poda.total_ramas_podadas == 0
+    # La poda no pierde el óptimo y visita menos estados
+    assert con_poda.ruta_optima == sin_poda.ruta_optima
+    assert con_poda.total_estados_visitados < sin_poda.total_estados_visitados
+    # Todas las rutas son caminos simples y están ordenadas por distancia
+    distancias = [d for _, d in sin_poda.rutas_encontradas]
+    assert distancias == sorted(distancias)
+    for camino, _ in sin_poda.rutas_encontradas:
+        assert len(camino) == len(set(camino))
+
+
+def test_sin_poda_respeta_calles_cerradas(grafo_diamante):
+    grafo_diamante.cambiar_estado_calle("N03", "N04", activa=False)
+    res = buscar_rutas_backtracking(grafo_diamante, "N01", "N04", usar_poda=False)
+    for camino, _ in res.rutas_encontradas:
+        assert ("N03", "N04") not in zip(camino, camino[1:])
+    assert res.ruta_optima[0] == ["N01", "N02", "N04"]
diff --git a/tests/test_dyv.py b/tests/test_dyv.py
index 57359a2..df753f5 100644
--- a/tests/test_dyv.py
+++ b/tests/test_dyv.py
@@ -55,3 +55,40 @@ def test_resolver_rutas_dyv_ensamble(pedidos_dispersos, grafo_minimo):
     assert len(ruta_global.pedidos_cubiertos) == len(pedidos_dispersos)
     assert ruta_global.distancia_total_m > 0.0
     assert ruta_global.secuencia_nodos[0] == "N01"
+
+
+def test_particion_en_r_zonas_exactas(pedidos_dispersos):
+    from core.divide_venceras import particionar_en_r_zonas
+    for r in (1, 2, 3, 4):
+        zonas = particionar_en_r_zonas(pedidos_dispersos, r)
+        assert len(zonas) == r
+        ids = [p.id for z in zonas for p in z]
+        assert sorted(ids) == sorted(p.id for p in pedidos_dispersos)
+        # Zonas balanceadas: tamaños difieren a lo sumo en 1 (6 pedidos / r)
+        tamanios = [len(z) for z in zonas]
+        assert max(tamanios) - min(tamanios) <= 1
+
+
+def test_un_repartidor_por_zona():
+    from core.divide_venceras import resolver_por_repartidores
+    from core.gestor_datos import cargar_grafo, cargar_pedidos, cargar_repartidores
+    grafo = cargar_grafo()
+    pedidos = cargar_pedidos()
+    repartidores = cargar_repartidores()
+    zonas = resolver_por_repartidores(pedidos, repartidores, grafo)
+    assert len(zonas) == len(repartidores)
+    assert {z.repartidor_id for z in zonas} == {r.id for r in repartidores}
+    cubiertos = [pid for z in zonas for pid in z.ruta_local.pedidos_cubiertos]
+    assert sorted(cubiertos) == sorted(p.id for p in pedidos)
+
+
+def test_held_karp_por_zona_no_peor_que_greedy():
+    from core.divide_venceras import ruta_optima_en_zona
+    from core.greedy import vecino_mas_cercano
+    from core.gestor_datos import cargar_grafo, cargar_pedidos
+    grafo = cargar_grafo()
+    pedidos = cargar_pedidos()[:8]
+    exacta = ruta_optima_en_zona("N01", pedidos, grafo)
+    voraz = vecino_mas_cercano("N01", pedidos, grafo)
+    assert exacta.distancia_total_m <= voraz.distancia_total_m + 1e-6
+    assert sorted(exacta.pedidos_cubiertos) == sorted(p.id for p in pedidos)
diff --git a/tests/test_pd.py b/tests/test_pd.py
index 8b130f9..cd3f1b1 100644
--- a/tests/test_pd.py
+++ b/tests/test_pd.py
@@ -72,3 +72,39 @@ def test_held_karp_tsp_4_puntos():
     assert ruta_idx[0] == 0 and ruta_idx[-1] == 0
     assert set(ruta_idx[:4]) == {0, 1, 2, 3}
     assert dist == sum(distancias[u][v] for u, v in zip(ruta_idx, ruta_idx[1:]))
+
+
+def test_mochila_pesos_decimales_no_exceden_capacidad():
+    """Regresión: con redondeo al kg, 4.5 kg se contaba como 4 y se excedía la capacidad."""
+    pedidos = [
+        Pedido("P1", "A", "N01", 0, 0, "S", 1, 4.5, 1.0, 100.0),
+        Pedido("P2", "B", "N01", 0, 0, "S", 1, 0.7, 1.0, 90.0),
+        Pedido("P3", "C", "N01", 0, 0, "S", 1, 2.2, 1.0, 50.0),
+    ]
+    valor, sel, _ = resolver_mochila_01(pedidos, capacidad_peso_kg=5)
+    assert sum(p.peso_kg for p in sel) <= 5.0
+    # 4.5 + 0.7 = 5.2 kg ya no es válido; lo mejor es 0.7 + 2.2 = 2.9 kg o 4.5 sola
+    assert valor == 140.0
+    assert [p.id for p in sel] == ["P2", "P3"]
+
+
+def test_mochila_datos_reales_respetan_capacidad():
+    from core.gestor_datos import cargar_pedidos
+    pedidos = cargar_pedidos()
+    for capacidad in (5, 10, 12.5, 15, 25, 35):
+        _, sel, _ = resolver_mochila_01(pedidos[:15], capacidad)
+        assert sum(p.peso_kg for p in sel) <= capacidad + 1e-9
+
+
+def test_mochila_coincide_con_fuerza_bruta():
+    """El óptimo de la PD es igual al de probar los 2^n subconjuntos (n = 12)."""
+    from core.gestor_datos import cargar_pedidos
+    pedidos = cargar_pedidos()[:12]
+    capacidad = 20
+    mejor = 0.0
+    for mascara in range(1 << len(pedidos)):
+        elegidos = [p for i, p in enumerate(pedidos) if mascara & (1 << i)]
+        if sum(p.peso_kg for p in elegidos) <= capacidad + 1e-9:
+            mejor = max(mejor, sum(p.valor_soles for p in elegidos))
+    valor, _, _ = resolver_mochila_01(pedidos, capacidad)
+    assert valor == pytest.approx(mejor)
diff --git a/tools/prueba_gui.py b/tools/prueba_gui.py
new file mode 100644
index 0000000..02e3334
--- /dev/null
+++ b/tools/prueba_gui.py
@@ -0,0 +1,285 @@
+"""
+Prueba de humo de la interfaz: abre la aplicación, pulsa cada funcionalidad de cada
+pestaña y comprueba que nada lance errores ni deje la ventana bloqueada.
+
+Uso:
+    python tools/prueba_gui.py                 # solo verifica
+    python tools/prueba_gui.py --capturas DIR  # además guarda capturas PNG de cada pestaña
+
+Las ventanas emergentes (messagebox) se reemplazan por registros en consola para que la
+prueba no se detenga esperando un clic.
+"""
+
+import argparse
+import sys
+import time
+import traceback
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+
+import tkinter as tk  # noqa: E402
+from tkinter import messagebox  # noqa: E402
+
+MENSAJES = []
+
+
+def _registrar(tipo):
+    def _f(titulo="", mensaje="", **_kw):
+        MENSAJES.append((tipo, titulo, mensaje))
+        print(f"  [{tipo}] {titulo}: {str(mensaje)[:90]}")
+        return True
+    return _f
+
+
+for _nombre in ("showinfo", "showwarning", "showerror", "askyesno"):
+    setattr(messagebox, _nombre, _registrar(_nombre))
+
+from gui.app import AppRutasCusco  # noqa: E402
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--capturas", type=Path, default=None)
+    args = parser.parse_args()
+    if args.capturas:
+        args.capturas.mkdir(parents=True, exist_ok=True)
+
+    app = AppRutasCusco()
+    app.geometry("1366x800+0+0")
+    errores = []
